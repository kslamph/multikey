		"url": "git+https://github.com/kslamph/pi-keypool.git"
	},
	"files": [
		"index.ts",
		"config.ts",
		"presets.ts",
		"pool.ts",
		"stream.ts",
		"manage.ts",
		"tui.ts",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": ["./index.ts"]
